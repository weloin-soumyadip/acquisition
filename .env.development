PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# App connection string via Neon Local proxy service on the Docker network
DATABASE_URL=postgres://neon:npg@neon-local:5432/acquisition?sslmode=require
NEON_USE_LOCAL=true
NEON_LOCAL_PROXY_URL=http://neon-local:5432/sql

# Neon Local credentials
NEON_API_KEY=replace_with_neon_api_key
NEON_PROJECT_ID=replace_with_neon_project_id

# Optional branch tuning for ephemeral branches
# If omitted, Neon Local uses your project's default branch as parent.
# PARENT_BRANCH_ID=br-xxxxx
DELETE_BRANCH=true
